{
  "name": "@wappajs/twilio",
  "version": "0.1.1",
  "description": "Twilio WhatsApp transport adapter for wappa — run a WhatsApp agent on a Twilio-provisioned number (BSP).",
  "type": "module",
  "license": "MIT",
  "author": "Sifen Fisaha",
  "homepage": "https://github.com/sifenfisaha/wappa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifenfisaha/wappa.git",
    "directory": "packages/twilio"
  },
  "bugs": {
    "url": "https://github.com/sifenfisaha/wappa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@wappajs/core": "^0.1.1"
  },
  "keywords": [
    "whatsapp",
    "twilio",
    "wappa",
    "transport"
  ]
}
